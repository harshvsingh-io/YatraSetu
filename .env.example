# ==============================================================================
# YATRASETU — ENVIRONMENT CONFIGURATION (.env.local)
# Smart India Hackathon 2026 (PS-Id SIH26202)
# ==============================================================================
# Note: YatraSetu works 100% out-of-the-box with built-in free tier fallback
# (Open-Meteo Weather, OpenStreetMap Nominatim, Wikipedia REST, LocalStorage Auth).
# Adding the keys below activates live cloud services.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE (Database & Cloud Authentication) - 100% Free
# Get it from: https://supabase.com -> New Project -> Project Settings -> API
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9...

# ------------------------------------------------------------------------------
# 2. GOOGLE GEMINI AI (Heritage Storyteller & AI Concierge) - 100% Free
# Get it from: https://aistudio.google.com/app/apikey (Instant free API key)
# ------------------------------------------------------------------------------
GEMINI_API_KEY=AIzaSy...

# ------------------------------------------------------------------------------
# 3. AMADEUS TRAVEL API (Real Hotel Search & Flight Rates) - Free Sandbox
# Get it from: https://developers.amadeus.com/register (2,000 free monthly calls)
# ------------------------------------------------------------------------------
AMADEUS_CLIENT_ID=your_amadeus_api_key
AMADEUS_CLIENT_SECRET=your_amadeus_api_secret

# ------------------------------------------------------------------------------
# 4. MAPBOX (Vector 3D Map Tiles) - Free Tier
# Get it from: https://account.mapbox.com/ (50,000 free map loads/month)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_MAPBOX_TOKEN=pk.eyJ1Ijoi...

# ------------------------------------------------------------------------------
# 5. RAZORPAY (UPI / RuPay Indian Payment Gateway) - Free Test Sandbox
# Get it from: https://dashboard.razorpay.com/ -> Settings -> API Keys (Test Mode)
# ------------------------------------------------------------------------------
NEXT_PUBLIC_RAZORPAY_KEY_ID=rzp_test_...
RAZORPAY_KEY_SECRET=your_razorpay_secret

# ------------------------------------------------------------------------------
# 6. FAST2SMS (Real Indian Phone OTP SMS Gateway) - Free Trial
# Get it from: https://www.fast2sms.com/ (Instant free trial credits)
# ------------------------------------------------------------------------------
FAST2SMS_API_KEY=your_fast2sms_auth_key
